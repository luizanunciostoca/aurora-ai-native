{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "paths": {
      "@aurora/contracts/policy-validation": [
        "../contracts/dist/policy-validation/index.d.ts"
      ]
    },
    "module": "Node16",
    "moduleResolution": "Node16",
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "rootDir": "src",
    "outDir": "dist"
  },
  "include": ["src/**/*.ts"],
  "exclude": [
    "src/**/*.test.ts",
    "src/**/*.contract-test.ts",
    "src/**/*.type-test.ts",
    "dist",
    "dist-test",
    "node_modules"
  ]
}
