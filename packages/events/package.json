{
  "name": "@aurora/events",
  "version": "0.1.0",
  "private": true,
  "description": "Coordinator-owned W03 shared event package scaffold for parallel leaf implementation.",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "require": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./delivery": {
      "types": "./dist/delivery/index.d.ts",
      "require": "./dist/delivery/index.js",
      "default": "./dist/delivery/index.js"
    }
  },
  "files": [
    "dist",
    "STATUS.md"
  ],
  "sideEffects": false,
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit --pretty false",
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "test": "npm run typecheck && npm run build && node --test"
  },
  "dependencies": {
    "@aurora/contracts": "0.1.0"
  },
  "engines": {
    "node": ">=22.16.0 <23",
    "npm": "10.9.2"
  }
}
