{
  "name": "@aurora/registries",
  "version": "0.1.0",
  "description": "Canonical Aurora AI-Native registries used by shared schemas.",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": ["dist"],
  "sideEffects": false,
  "exports": {
    ".": { "types": "./dist/index.d.ts", "require": "./dist/index.js", "default": "./dist/index.js" },
    "./ids": { "types": "./dist/ids/index.d.ts", "require": "./dist/ids/index.js", "default": "./dist/ids/index.js" },
    "./versioning": { "types": "./dist/versioning/index.d.ts", "require": "./dist/versioning/index.js", "default": "./dist/versioning/index.js" }
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit --pretty false",
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "test": "npm run typecheck && npm run build && node --test test/shipping.test.mjs",
    "clean": "rm -rf dist dist-test"
  },
  "dependencies": { "@aurora/contracts": "0.1.0" },
  "engines": { "node": ">=22.16.0 <23", "npm": "10.9.2" }
}
