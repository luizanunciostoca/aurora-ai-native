{
  "name": "@aurora/policy-core",
  "version": "0.0.0",
  "private": true,
  "description": "Canonical deterministic Aurora AI-Native policy runtime.",
  "main": "./dist/packages/policy/src/index.js",
  "types": "./dist/packages/policy/src/index.d.ts",
  "files": [
    "dist/packages/policy/src"
  ],
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/packages/policy/src/index.d.ts",
      "require": "./dist/packages/policy/src/index.js",
      "default": "./dist/packages/policy/src/index.js"
    },
    "./authority": {
      "types": "./dist/packages/policy/src/authority/index.d.ts",
      "require": "./dist/packages/policy/src/authority/index.js",
      "default": "./dist/packages/policy/src/authority/index.js"
    }
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit --pretty false",
    "build": "rm -rf dist && tsc -p tsconfig.json",
    "test": "npm run typecheck && npm run build && node --test dist/packages/policy/test/*.test.js",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@aurora/contracts": "0.1.0"
  },
  "engines": {
    "node": ">=22.16.0 <23",
    "npm": "10.9.2"
  }
}
