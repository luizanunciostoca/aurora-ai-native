{
  "name": "@aurora/contracts",
  "version": "0.1.0",
  "description": "Canonical Aurora AI-Native wire and domain contracts.",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "STATUS.md",
    "docs"
  ],
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "require": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./actions": {
      "types": "./dist/actions/index.d.ts",
      "require": "./dist/actions/index.js",
      "default": "./dist/actions/index.js"
    },
