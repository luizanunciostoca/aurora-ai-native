      "default": "./dist/tenant-boundary/index.js"
    },
    "./versioning": {
      "types": "./dist/versioning/index.d.ts",
      "require": "./dist/versioning/index.js",
      "default": "./dist/versioning/index.js"
    }
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit --pretty false",
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "test": "npm run typecheck && npm run build && node --test test/package-boundaries.test.mjs test/shipping.test.mjs",
    "clean": "rm -rf dist dist-test"
  },
  "engines": {
    "node": ">=22.16.0 <23",
    "npm": "10.9.2"
  }
}
