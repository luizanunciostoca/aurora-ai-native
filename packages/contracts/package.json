      "default": "./dist/context/index.js"
    },
    "./envelopes": {
      "types": "./dist/envelopes/index.d.ts",
      "require": "./dist/envelopes/index.js",
      "default": "./dist/envelopes/index.js"
    },
    "./evidence": {
      "types": "./dist/evidence/index.d.ts",
      "require": "./dist/evidence/index.js",
      "default": "./dist/evidence/index.js"
    },
    "./ids": {
      "types": "./dist/ids/index.d.ts",
