      "default": "./dist/identity-resolution/index.js"
    },
    "./jurisdiction": {
      "types": "./dist/jurisdiction/index.d.ts",
      "require": "./dist/jurisdiction/index.js",
      "default": "./dist/jurisdiction/index.js"
    },
    "./policy": {
      "types": "./dist/policy/index.d.ts",
      "require": "./dist/policy/index.js",
      "default": "./dist/policy/index.js"
    },
    "./purpose": {
      "types": "./dist/purpose/index.d.ts",
      "require": "./dist/purpose/index.js",
      "default": "./dist/purpose/index.js"
    },
    "./receipts": {
      "types": "./dist/receipts/index.d.ts",
      "require": "./dist/receipts/index.js",
      "default": "./dist/receipts/index.js"
    },
    "./results": {
      "types": "./dist/results/index.d.ts",
