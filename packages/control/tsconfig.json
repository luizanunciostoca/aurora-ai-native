{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "allowImportingTsExtensions": true,
    "baseUrl": ".",
    "paths": {
      "@aurora/contracts": ["../contracts/src/index.ts"],
      "@aurora/contracts/*": ["../contracts/src/*/index.ts"]
    },
    "noEmit": true
  },
  "include": ["src/**/*.ts", "test/**/*.ts"],
  "exclude": ["dist", "dist-test", "node_modules"]
}
