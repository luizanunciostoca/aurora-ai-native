{
  "schemaVersion": 5,
  "mode": "FREE_ACTIONS_CLI",
  "activationState": "PRO_PLUS_REALITY_GATE_BOOTSTRAP",
  "cloudAgentEnabled": false,
  "proPlusActionsFabricEnabled": false,
  "freeActionsCliEnabled": true,
  "fallbackPhysicalBuildSlots": 2,
  "prebuildWorkerEnabled": false,
  "maxParallelTasks": 2,
  "physicalBuildSlots": 2,
  "maxLogicalLanes": 64,
  "maxPrebuildArtifactLanes": 48,
  "copilotModel": "auto",
  "runtimeCapabilityDiscovery": {
    "enabled": true,
    "failurePolicy": "FAIL_CLOSED_TO_FREE_FALLBACK",
    "requiredForProPlus": true,
    "attestationPath": "docs/governance/copilot/AURORA_PRO_PLUS_RUNTIME_ATTESTATION.json",
    "minimumObservedConcurrentSessions": 4,
    "attestationMaxAgeMinutes": 1440,
    "signals": ["MEASURED_COPILOT_CLI_SUCCESS", "MEASURED_CONCURRENT_JOB_OVERLAP", "EXACT_WORKFLOW_RUN_ID", "EXACT_CANDIDATE_SHA", "ATTESTATION_EXPIRY"]
  },
  "capacityController": {
    "strategy": "MINIMUM_SAFE_DIMENSION",
    "subtractActiveSessionLeases": true,
    "respectWriterLeases": true,
    "unknownCapacityPolicy": "FREE_FALLBACK_ONLY"
  },
  "sessionLeaseRegistry": {
    "source": "LIVE_GITHUB_ISSUE_TASK_PROJECTION",
    "lockDimensions": ["allowedPaths", "sharedWriteSurfaces"],
    "staleLeasePolicy": "FAIL_CLOSED_UNTIL_RECONCILED",
    "prOpenConsumesBuildSession": false
  },
  "developmentTelemetry": {
    "enabled": true,
    "schema": "aurora.pro_plus.development_telemetry.v1",
    "canonicalAuthority": false
  },
  "scheduler": {
    "strategy": "PUZZLE_FRONTIER",
    "optimizeFor": "MINIMUM_SAFE_CRITICAL_PATH",
    "buildSelection": "EXPLICIT_PRIORITY_THEN_LONGEST_REMAINING_PATH",
    "prebuildSelection": "WAVE_SEEDS_THEN_LOWEST_SPECULATION_DEPTH_THEN_CRITICAL_PATH",
    "canonicalDependencyPolicy": "ACCEPTED_ONLY",
    "prebuildPublicationPolicy": "ARTIFACT_ONLY_UNTIL_DEPENDENCIES_ACCEPTED",
    "sharedWriteConflictPolicy": "FAIL_CLOSED_DEFER",
    "pathFencePolicy": "REQUIRED_FOR_PATCH_PREBUILD",
    "contractReconciliationPolicy": "REQUIRED_BEFORE_BUILD_PROMOTION",
    "runningTaskActivationPolicy": "NON_RETROACTIVE",
    "handoffFormat": "AURORA_COMPACT_V1"
  },
  "upgradeTarget": "PRO_PLUS_ACTIONS_FABRIC",
  "authority": "Operational execution mode only. Live main, exact-SHA evidence, CURRENT_PROGRAM_STATUS, Developer Manual, ADRs and owning wave governance remain authoritative.",
  "notes": [
    "This bootstrap keeps physical BUILD concurrency at the accepted Free-compatible ceiling while installing the measured PRO+ Reality Gate.",
    "PRO_PLUS_ACTIONS_FABRIC may be activated only after a fresh VERIFIED runtime attestation proves concurrent Copilot CLI capacity.",
    "Unknown or expired PRO+ evidence never widens capacity.",
    "Increasing measured safe BUILD capacity never weakens dependency, path, shared-surface, exact-head, Risk Gate, review or acceptance barriers."
  ]
}
