{
  "name": "aurora-ai-native",
  "version": "0.0.0",
  "lockfileVersion": 3,
  "requires": true,
  "packages": {
    "": {
      "name": "aurora-ai-native",
      "version": "0.0.0",
      "hasInstallScript": true,
      "workspaces": [
        "apps/*",
        "services/*",
        "packages/*",
        "catalog/*",
        "infra/*",
        "evals/*",
        "tools/*"
      ],
      "engines": {
        "node": ">=22.16.0 <23",
        "npm": "10.9.2"
      }
    },
    "node_modules/@aurora/workspace-tools": {
      "resolved": "tools/workspace",
      "link": true
    },
    "tools/workspace": {
      "name": "@aurora/workspace-tools",
      "version": "0.0.0",
      "engines": {
        "node": ">=22.16.0 <23",
        "npm": "10.9.2"
      }
    }
  }
}
